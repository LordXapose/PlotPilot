# 1. DATA EXPLORATION
# ─────────────────────────────────────────────────────────────────
class DataExplorer:
    """
    Module 1 – Data Exploration
    Handles loading, inspection, cleaning, and missing-value analysis.
    """

    def __init__(self, df: pd.DataFrame):
        self.df = df.copy()
        self._original_shape = df.shape

    # ── Loading helpers ──────────────────────────────────────────
    @classmethod
    def from_csv(cls, path: str, **kwargs) -> "DataExplorer":
        df = pd.read_csv(path, **kwargs)
        _ok(f"Loaded CSV: {path}  →  {df.shape[0]:,} rows × {df.shape[1]} cols")
        return cls(df)

    @classmethod
    def from_excel(cls, path: str, **kwargs) -> "DataExplorer":
        df = pd.read_excel(path, **kwargs)
        _ok(f"Loaded Excel: {path}  →  {df.shape[0]:,} rows × {df.shape[1]} cols")
        return cls(df)

    @classmethod
    def from_json(cls, path: str, **kwargs) -> "DataExplorer":
        df = pd.read_json(path, **kwargs)
        _ok(f"Loaded JSON: {path}  →  {df.shape[0]:,} rows × {df.shape[1]} cols")
        return cls(df)

    @classmethod
    def sample_dataset(cls, name: str = "iris") -> "DataExplorer":
        """Load a built-in sample dataset (iris, titanic, diamonds, tips, penguins)."""
        datasets = {
            "iris":     sns.load_dataset("iris"),
            "titanic":  sns.load_dataset("titanic"),
            "diamonds": sns.load_dataset("diamonds"),
            "tips":     sns.load_dataset("tips"),
            "penguins": sns.load_dataset("penguins"),
        }
        if name not in datasets:
            raise ValueError(f"Unknown dataset '{name}'. Choose from: {list(datasets)}")
        df = datasets[name]
        _ok(f"Loaded sample dataset '{name}'  →  {df.shape[0]:,} rows × {df.shape[1]} cols")
        return cls(df)

    # ── Inspection ───────────────────────────────────────────────
    def overview(self):
        """Print a comprehensive dataset overview."""
        _section("DATA OVERVIEW")
        df = self.df

        _subsection("Shape & Memory")
        mem_mb = df.memory_usage(deep=True).sum() / 1e6
        print(f"  Rows: {df.shape[0]:,}   Cols: {df.shape[1]}   Memory: {mem_mb:.2f} MB")

        _subsection("Column Types")
        type_counts = df.dtypes.value_counts()
        for dtype, count in type_counts.items():
            print(f"  {str(dtype):<15} {count} column(s)")

        _subsection("First 5 Rows")
        print(df.head().to_string(max_cols=10))

        _subsection("Data Types per Column")
        print(df.dtypes.to_frame("dtype").to_string())

        return self

    def missing_analysis(self, plot: bool = True) -> pd.DataFrame:
        """Detailed missing value analysis."""
        _section("MISSING VALUE ANALYSIS")
        df = self.df

        miss = pd.DataFrame({
            "missing":   df.isnull().sum(),
            "pct":       (df.isnull().sum() / len(df) * 100).round(2),
            "dtype":     df.dtypes,
        }).sort_values("missing", ascending=False)

        miss["status"] = miss["pct"].apply(
            lambda p: "🔴 High (>20%)" if p > 20 else ("🟡 Medium (5-20%)" if p > 5 else "🟢 Low (<5%)")
        )

        total_miss = df.isnull().sum().sum()
        _info(f"Total missing cells: {total_miss:,} / {df.size:,} ({total_miss/df.size*100:.2f}%)")
        print()
        print(miss[miss["missing"] > 0].to_string() if miss["missing"].sum() > 0 else "  ✓ No missing values found!")

        if plot and miss["missing"].sum() > 0:
            fig, axes = plt.subplots(1, 2, figsize=(14, 5))
            fig.suptitle("Missing Value Analysis", fontsize=15, fontweight="bold", y=1.01)

            # Bar chart
            miss_only = miss[miss["missing"] > 0].head(20)
            axes[0].barh(miss_only.index, miss_only["pct"],
                         color=[PALETTE["danger"] if p > 20 else PALETTE["warning"] if p > 5 else PALETTE["success"]
                                for p in miss_only["pct"]])
            axes[0].set_xlabel("Missing %")
            axes[0].set_title("Missing % by Column")
            axes[0].axvline(5, color=PALETTE["warning"], linestyle="--", alpha=0.7, label="5% threshold")
            axes[0].axvline(20, color=PALETTE["danger"], linestyle="--", alpha=0.7, label="20% threshold")
            axes[0].legend(fontsize=8)

            # Heatmap-style missingness pattern
            miss_cols = miss[miss["missing"] > 0].index.tolist()
            if len(miss_cols) > 0:
                sample = df[miss_cols].head(100).isnull().astype(int)
                im = axes[1].imshow(sample.T, aspect="auto", cmap="RdYlGn_r", vmin=0, vmax=1)
                axes[1].set_yticks(range(len(miss_cols)))
                axes[1].set_yticklabels(miss_cols, fontsize=8)
                axes[1].set_xlabel("Row index (first 100)")
                axes[1].set_title("Missingness Pattern (yellow = missing)")
                plt.colorbar(im, ax=axes[1], shrink=0.8)

            plt.tight_layout()
            _save_fig(fig, "01_missing_analysis")

        return miss

    # ── Cleaning ─────────────────────────────────────────────────
    def drop_duplicates(self, inplace: bool = True) -> "DataExplorer":
        """Remove duplicate rows."""
        n_before = len(self.df)
        cleaned = self.df.drop_duplicates()
        n_dropped = n_before - len(cleaned)
        if inplace:
            self.df = cleaned
        _ok(f"Dropped {n_dropped} duplicate rows ({n_dropped/n_before*100:.1f}%)")
        return self

    def drop_high_missing(self, threshold: float = 0.5, inplace: bool = True) -> "DataExplorer":
        """Drop columns with more than `threshold` fraction missing."""
        miss_frac = self.df.isnull().mean()
        to_drop = miss_frac[miss_frac > threshold].index.tolist()
        if to_drop:
            cleaned = self.df.drop(columns=to_drop)
            if inplace:
                self.df = cleaned
            _warn(f"Dropped {len(to_drop)} columns with >{threshold*100:.0f}% missing: {to_drop}")
        else:
            _ok(f"No columns exceed {threshold*100:.0f}% missing threshold")
        return self

    def impute(self, strategy: str = "median", columns: Optional[List[str]] = None) -> "DataExplorer":
        """
        Impute missing values.
        strategy: 'mean', 'median', 'mode', 'ffill', 'bfill', or a constant value
        """
        df = self.df.copy()
        num_cols = df.select_dtypes(include="number").columns.tolist()
        cat_cols = df.select_dtypes(include="object").columns.tolist()
        target = columns if columns else num_cols

        for col in target:
            if df[col].isnull().sum() == 0:
                continue
            if strategy == "mean":
                df[col].fillna(df[col].mean(), inplace=True)
            elif strategy == "median":
                df[col].fillna(df[col].median(), inplace=True)
            elif strategy == "mode":
                df[col].fillna(df[col].mode()[0], inplace=True)
            elif strategy in ("ffill", "bfill"):
                df[col].fillna(method=strategy, inplace=True)
            else:
                df[col].fillna(strategy, inplace=True)

        for col in cat_cols:
            if df[col].isnull().sum() > 0:
                df[col].fillna(df[col].mode()[0] if len(df[col].mode()) > 0 else "Unknown", inplace=True)

        self.df = df
        _ok(f"Imputed missing values using strategy='{strategy}'")
        return self

    def export(self, path: str, fmt: str = "csv") -> "DataExplorer":
        """Export cleaned data to CSV, Excel, or JSON."""
        os.makedirs(os.path.dirname(path) if os.path.dirname(path) else ".", exist_ok=True)
        if fmt == "csv":
            self.df.to_csv(path, index=False)
        elif fmt == "excel":
            self.df.to_excel(path, index=False)
        elif fmt == "json":
            self.df.to_json(path, orient="records", indent=2)
        _ok(f"Exported {len(self.df):,} rows to: {path}")
        return self


