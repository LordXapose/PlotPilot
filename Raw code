# 2. DESCRIPTIVE STATISTICS
# ─────────────────────────────────────────────────────────────────
class DescriptiveStats:
    """
    Module 2 – Descriptive Statistics
    Measures of central tendency, spread, shape, and correlation.
    """

    def __init__(self, df: pd.DataFrame):
        self.df = df
        self.num_cols = df.select_dtypes(include="number").columns.tolist()
        self.cat_cols = df.select_dtypes(include=["object", "category"]).columns.tolist()

    def summary(self, extended: bool = True) -> pd.DataFrame:
        """Extended summary statistics table."""
        _section("DESCRIPTIVE STATISTICS")

        if not self.num_cols:
            _warn("No numeric columns found.")
            return pd.DataFrame()

        df = self.df[self.num_cols]

        summary = pd.DataFrame({
            "n":        df.count(),
            "mean":     df.mean(),
            "median":   df.median(),
            "std":      df.std(),
            "var":      df.var(),
            "sem":      df.sem(),
            "min":      df.min(),
            "Q1":       df.quantile(0.25),
            "Q3":       df.quantile(0.75),
            "max":      df.max(),
            "IQR":      df.quantile(0.75) - df.quantile(0.25),
            "range":    df.max() - df.min(),
            "skew":     df.skew(),
            "kurtosis": df.kurtosis(),
            "cv%":      (df.std() / df.mean() * 100).abs(),
            "missing":  df.isnull().sum(),
        }).round(4)

        _subsection("Summary Table")
        print(summary.to_string())

        if extended:
            _subsection("Categorical Variables")
            for col in self.cat_cols:
                vc = self.df[col].value_counts()
                print(f"\n  [{col}]  Unique: {self.df[col].nunique()}")
                print(vc.head(10).to_string())

        return summary

    def correlation_matrix(self, method: str = "pearson", plot: bool = True) -> pd.DataFrame:
        """Compute and optionally visualize correlation matrix."""
        _subsection(f"Correlation Matrix ({method})")

        if len(self.num_cols) < 2:
            _warn("Need at least 2 numeric columns for correlation.")
            return pd.DataFrame()

        corr = self.df[self.num_cols].corr(method=method)
        print(corr.round(3).to_string())

        if plot:
            fig, ax = plt.subplots(figsize=(max(8, len(self.num_cols) * 0.9),
                                            max(6, len(self.num_cols) * 0.8)))
            mask = np.triu(np.ones_like(corr, dtype=bool))
            sns.heatmap(
                corr, mask=mask, annot=True, fmt=".2f", cmap="coolwarm",
                center=0, square=True, linewidths=0.5, ax=ax,
                cbar_kws={"shrink": 0.8},
                annot_kws={"size": 8},
            )
            ax.set_title(f"Correlation Matrix ({method.capitalize()})", pad=15)
            plt.tight_layout()
            _save_fig(fig, "02_correlation_matrix")

        return corr

    def frequency_table(self, column: str, bins: int = 10) -> pd.DataFrame:
        """Frequency distribution table for a column."""
        _subsection(f"Frequency Table: {column}")

        col = self.df[column]
        if col.dtype in ["object", "category"]:
            freq = col.value_counts().reset_index()
            freq.columns = ["value", "count"]
            freq["pct"] = (freq["count"] / len(col) * 100).round(2)
            freq["cum_pct"] = freq["pct"].cumsum().round(2)
        else:
            freq_vals, bin_edges = np.histogram(col.dropna(), bins=bins)
            freq = pd.DataFrame({
                "bin_start": bin_edges[:-1].round(3),
                "bin_end":   bin_edges[1:].round(3),
                "count":     freq_vals,
                "pct":       (freq_vals / freq_vals.sum() * 100).round(2),
                "cum_pct":   (np.cumsum(freq_vals) / freq_vals.sum() * 100).round(2),
            })

        print(freq.to_string(index=False))
        return freq


