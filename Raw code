# ─────────────────────────────────────────────────────────────────
# HELPER UTILITIES
# ─────────────────────────────────────────────────────────────────
def _section(title: str, width: int = 70):
    """Print a styled section header."""
    print(f"\n{'═'*width}")
    print(f"  {title}")
    print(f"{'═'*width}")


def _subsection(title: str):
    print(f"\n  ── {title} {'─'*(60 - len(title))}")


def _info(msg: str):
    print(f"  ℹ  {msg}")


def _warn(msg: str):
    print(f"  ⚠  {msg}")


def _ok(msg: str):
    print(f"  ✓  {msg}")


def _save_fig(fig, name: str, output_dir: str = "toolkit_output"):
    """Save figure to output directory."""
    os.makedirs(output_dir, exist_ok=True)
    path = os.path.join(output_dir, f"{name}.png")
    fig.savefig(path, dpi=150, bbox_inches="tight", facecolor=PALETTE["bg"])
    print(f"  → Saved: {path}")
    plt.close(fig)
    return path


