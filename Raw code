# 3. DATA VISUALIZATION
# ─────────────────────────────────────────────────────────────────
class DataVisualizer:
    """
    Module 3 – Data Visualization
    Univariate, bivariate, and multivariate plots.
    """

    def __init__(self, df: pd.DataFrame):
        self.df = df
        self.num_cols = df.select_dtypes(include="number").columns.tolist()
        self.cat_cols = df.select_dtypes(include=["object", "category"]).columns.tolist()
        self.colors = list(PALETTE.values())

    def univariate(self) -> None:
        """Histogram + KDE + boxplot for each numeric column."""
        _section("UNIVARIATE VISUALIZATIONS")
        n = len(self.num_cols)
        if n == 0:
            _warn("No numeric columns."); return

        cols_per_row = min(3, n)
        rows = (n + cols_per_row - 1) // cols_per_row
        fig, axes = plt.subplots(rows * 2, cols_per_row,
                                 figsize=(5 * cols_per_row, 4 * rows))
        fig.suptitle("Univariate Analysis – Histograms & Boxplots",
                     fontsize=14, fontweight="bold", y=1.01)

        axes = np.array(axes).reshape(rows * 2, cols_per_row)

        for i, col in enumerate(self.num_cols):
            row, c = divmod(i, cols_per_row)
            data = self.df[col].dropna()
            color = self.colors[i % len(self.colors)]

            # Histogram + KDE
            ax_hist = axes[row * 2, c]
            ax_hist.hist(data, bins=30, color=color, alpha=0.7, edgecolor="white", density=True)
            try:
                kde_x = np.linspace(data.min(), data.max(), 200)
                kde = stats.gaussian_kde(data)
                ax_hist.plot(kde_x, kde(kde_x), color=PALETTE["dark"], lw=1.5, label="KDE")
            except Exception:
                pass
            ax_hist.set_title(col, fontsize=10)
            ax_hist.set_ylabel("Density")
            mean_val = data.mean()
            ax_hist.axvline(mean_val, color=PALETTE["accent"], linestyle="--", lw=1,
                            label=f"Mean={mean_val:.2f}")
            ax_hist.legend(fontsize=7)

            # Boxplot
            ax_box = axes[row * 2 + 1, c]
            bp = ax_box.boxplot(data, vert=False, patch_artist=True,
                                boxprops=dict(facecolor=color, alpha=0.6),
                                medianprops=dict(color=PALETTE["dark"], linewidth=2),
                                flierprops=dict(marker="o", markersize=3, alpha=0.5,
                                                markerfacecolor=PALETTE["accent"]))
            ax_box.set_xlabel(col, fontsize=9)
            ax_box.set_yticks([])

        # Hide empty subplots
        for i in range(n, rows * cols_per_row):
            row, c = divmod(i, cols_per_row)
            axes[row * 2, c].set_visible(False)
            axes[row * 2 + 1, c].set_visible(False)

        plt.tight_layout()
        _save_fig(fig, "03_univariate")

    def bivariate(self) -> None:
        """Scatter plots and pairplot for numeric features."""
        _section("BIVARIATE & PAIRPLOT")
        if len(self.num_cols) < 2:
            _warn("Need ≥2 numeric columns for bivariate plots."); return

        cols = self.num_cols[:6]  # cap at 6 for readability
        hue = self.cat_cols[0] if self.cat_cols else None

        fig = sns.pairplot(
            self.df[cols + ([hue] if hue else [])].dropna(),
            hue=hue, diag_kind="kde",
            plot_kws={"alpha": 0.5, "s": 20},
            diag_kws={"fill": True},
            palette="husl",
        )
        fig.fig.suptitle("Pairplot – Numeric Features", y=1.02, fontsize=14, fontweight="bold")
        _save_fig(fig.fig, "04_pairplot")

    def categorical(self) -> None:
        """Bar charts and count plots for categorical columns."""
        _section("CATEGORICAL VISUALIZATIONS")
        if not self.cat_cols:
            _warn("No categorical columns."); return

        n = min(len(self.cat_cols), 4)
        fig, axes = plt.subplots(1, n, figsize=(5 * n, 5))
        if n == 1:
            axes = [axes]
        fig.suptitle("Categorical Distributions", fontsize=14, fontweight="bold")

        for i, col in enumerate(self.cat_cols[:n]):
            ax = axes[i]
            vc = self.df[col].value_counts().head(12)
            colors = sns.color_palette("husl", len(vc))
            ax.barh(vc.index.astype(str), vc.values, color=colors)
            ax.set_title(col)
            ax.set_xlabel("Count")
            for j, (val, cnt) in enumerate(zip(vc.index, vc.values)):
                ax.text(cnt * 1.01, j, f"{cnt:,}", va="center", fontsize=8)

        plt.tight_layout()